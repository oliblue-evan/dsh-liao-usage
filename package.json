{
  "name": "dsh-usage-pill",
  "version": "1.2.0",
  "main": "./index.js",
  "private": true,
  "description": "查看会话用量、DeepSeek 价表参考费用与账户余额；按模型展开明细，自定义底部胶囊。 | View session tokens, reference costs using DeepSeek rates and account balance; explore model details and customize the bottom pill.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliblue-evan/dsh-usage-pill.git"
  },
  "author": "李敖 (oliblue)",
  "license": "MIT",
  "icon": "assets/icon.svg",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./assets/*": "./assets/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "assets",
    "README.md"
  ],
  "disclosure": {
    "cloud": true,
    "network": [
      "https://api.deepseek.com"
    ],
    "offlineMode": true,
    "apiKeys": [
      {
        "env": "DEEPSEEK_API_KEY",
        "storage": "file-0600"
      }
    ],
    "permissions": [
      "network:https://api.deepseek.com",
      "credentials:read:DEEPSEEK_API_KEY",
      "filesystem:none"
    ],
    "jurisdiction": [
      "PIPL(CN)"
    ],
    "retention": "none"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "jsdom": "^30.1.2"
  }
}
